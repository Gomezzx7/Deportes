  <entrenamientos>
    <titulo>Planes de Entrenamiento</titulo>
    <plan>
      <nombre>Entrenamiento de Resistencia</nombre>
      <descripcion>Mejora tu capacidad aeróbica con ejercicios de carrera, ciclismo y natación.</descripcion>
    </plan>
    <plan>
      <nombre>Fuerza y Musculación</nombre>
      <descripcion>Desarrolla tu fuerza con rutinas de pesas y ejercicios funcionales.</descripcion>
    </plan>
    <plan>
      <nombre>Flexibilidad y Movilidad</nombre>
      <descripcion>Optimiza tu movilidad con yoga, pilates y estiramientos dinámicos.</descripcion>
    </plan>
    <plan>
      <nombre>Entrenamiento Deportivo Específico</nombre>
      <descripcion>Programas diseñados para mejorar el rendimiento en deportes como fútbol, baloncesto y tenis.</descripcion>
    </plan>

    <comparativa>
      <entrenamiento tipo="Resistencia" duracion="3 meses" modalidad="Presencial"/>
      <entrenamiento tipo="Fuerza" duracion="4 meses" modalidad="Presencial"/>
      <entrenamiento tipo="Flexibilidad" duracion="2 meses" modalidad="Presencial"/>
      <entrenamiento tipo="Deportivo Específico" duracion="6 meses" modalidad="Presencial"/>
    </comparativa>
  </entrenamientos>

